# Vite Frontend Environment Configuration
# In local development, leave VITE_API_BASE_URL empty so Vite proxies /api/* to http://127.0.0.1:8000
# In Vercel production, set VITE_API_BASE_URL to your deployed Render backend URL (no trailing slash):
# VITE_API_BASE_URL=https://your-render-backend.onrender.com
VITE_API_BASE_URL=
