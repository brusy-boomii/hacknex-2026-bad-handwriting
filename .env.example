# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT=8000  # Automatically injected by Render in production
ENVIRONMENT=development

# CORS Configuration (Comma-separated list of allowed origins; do NOT use "*")
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional single deployed Vercel frontend URL (appended to ALLOWED_ORIGINS automatically):
# FRONTEND_URL=https://your-project-name.vercel.app

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit

# Phase 3 Uncertainty & Image Quality Thresholds
UNCERTAINTY_HIGH_CONFIDENCE_THRESHOLD=0.82
UNCERTAINTY_LOW_CONFIDENCE_THRESHOLD=0.60
UNCERTAINTY_UNREADABLE_CONFIDENCE_THRESHOLD=0.35
UNCERTAINTY_HIGH_RELIABILITY_THRESHOLD=0.78
UNCERTAINTY_LOW_RELIABILITY_THRESHOLD=0.62
UNCERTAINTY_UNREADABLE_RELIABILITY_THRESHOLD=0.38
UNCERTAINTY_BLUR_LAPLACIAN_THRESHOLD=45.0
UNCERTAINTY_LOW_CONTRAST_RANGE_THRESHOLD=45.0

# Phase 4 Selective Secondary Verification (Optional — disabled by default)
SECONDARY_VERIFICATION_ENABLED=false
SECONDARY_VERIFICATION_PROVIDER=none
# Do NOT commit real API keys; set SECONDARY_VERIFICATION_API_KEY only in local .env if used

# Frontend Configuration (Set in Vercel Environment Variables or frontend/.env)
# Leave empty in local development to use the Vite /api proxy -> http://127.0.0.1:8000
VITE_API_BASE_URL=


